.env
.venv/
__pycache__/
*.pyc
# stats raw stays local (regenerable from upstream releases + live ESPN);
# odds raw IS committed — it's the irreplaceable archive (phase 10 decision)
data/raw/stats/
*.db
# phase 10 exception: GitHub Actions commits the database back after each
# collection run (see DECISIONS.md; git warns at 50 MB, hard-limits at 100 MB)
!data/wnba.db
*.db-journal
logs/*.log
reports/*.png
models/
# pip install -e . artifact
src/*.egg-info/
*.egg-info/
